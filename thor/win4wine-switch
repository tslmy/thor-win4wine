#!/bin/bash
# User-facing switch; the independent root service survives closing the desktop.
set -euo pipefail
[[ $# == 1 ]] || { echo 'Usage: win4wine-switch xp|reactos|win7' >&2; exit 2; }
case "${1:-}" in xp|reactos|win7) variant=$1 ;; *) echo 'Usage: win4wine-switch xp|reactos|win7' >&2; exit 2;; esac
# armada#953: a DP disable after a failed link training resets the SoC. XREAL
# glasses (EDID maker MRG, 0x3647) often fail their first training and re-assert
# hot-plug while SDDM restarts, so refuse with them connected. Other monitors may
# stay connected; an unreadable EDID counts as glasses.
for dp in /sys/class/drm/card*-DP-*; do
    [[ $(cat "$dp/status" 2>/dev/null) == connected ]] || continue
    maker=$(od -An -tx1 -j8 -N2 "$dp/edid" 2>/dev/null | tr -d ' \n')
    if [[ -z $maker || $maker == 3647 ]]; then
        message='Unplug the XREAL glasses first: with them connected, a shell switch can reset the Thor (armada#953). Other monitors can stay connected.'
        echo "$message" >&2
        if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
            kdialog --error "$message" --title 'win4wine display safety guard' || true
        fi
        exit 1
    fi
done
exec sudo -n systemd-run --collect --unit="win4wine-switch-$variant-$(date +%s%N)" \
    /usr/bin/python3 /etc/win4wine/switch-win4wine-session.py "$variant"
