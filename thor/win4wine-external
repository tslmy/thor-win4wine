#!/usr/bin/env python3
"""External monitor for a running win4wine standalone session, laptop style.

Plugged in, DP-1 becomes the primary screen: the desktop, taskbar and open
windows move to it and the upper panel becomes the second screen. Unplugged,
they come back. Nothing is restarted.

Only the upper panel plus DP-1 at no more than 1080p. DP-1 is switched back off
if the display driver reports errors shortly after it is enabled.

"watch" does this on plug and unplug, in Windows 7 and XP sessions.
"desktop external" and "desktop handheld" swap the primary screen by hand.
"""
import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

UPPER, LOWER, EXTERNAL = 'DSI-2', 'DSI-1', 'DP-1'
WATCH_SECONDS = 20
# Consecutive one-second readings before a plug or unplug counts: DP links flap.
SETTLE = 3
# ReactOS has never driven a monitor here.
AUTOMATIC_SHELLS = ('win7', 'xp')
ERRORS = re.compile(
    r'failed to reserve hw resources|invalid DSPP|unable to find appropriate mixers'
    r'|\[dpu error\]|vblank timeout|flip_done timed out|commit wait timed out', re.I)


def environment():
    env = dict(os.environ)
    env.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    if 'WAYLAND_DISPLAY' not in env:
        sockets = [p for p in Path(env['XDG_RUNTIME_DIR']).glob('wayland-*') if p.is_socket()]
        if len(sockets) != 1:
            sys.exit(f'Expected one Wayland socket, found {len(sockets)}. Set WAYLAND_DISPLAY.')
        env['WAYLAND_DISPLAY'] = sockets[0].name
    return env


def outputs(env):
    listing = subprocess.check_output(['wlr-randr', '--json'], env=env, text=True, timeout=10)
    return {o['name']: o for o in json.loads(listing)}


def kernel_errors(since):
    log = subprocess.check_output(
        ['journalctl', '-k', '-b', '--no-pager', '-o', 'cat', f'--since=@{since}'],
        text=True, timeout=10)
    return [line for line in log.splitlines() if ERRORS.search(line)]


def session():
    """The running supervisor's configuration and IPC directory."""
    for process in Path('/proc').glob('[0-9]*'):
        try:
            command = (process / 'cmdline').read_bytes().decode().split('\0')
            if not any(a.endswith('/session/supervisor.py') for a in command):
                continue
            variables = dict(v.split('=', 1) for v in
                             (process / 'environ').read_bytes().decode().split('\0') if '=' in v)
            config = json.loads(Path(command[command.index('--config') + 1]).read_text())
            return config, Path(variables['WIN4WINE_IPC'])
        except (OSError, ValueError, KeyError, IndexError):
            continue
    sys.exit('No running win4wine standalone session found.')


def primary_name():
    try:
        return (session()[1] / 'primary').read_text().strip()
    except OSError:
        return ''


def logical_width(output):
    mode = next(m for m in output['modes'] if m.get('current'))
    turned = str(output.get('transform')).endswith(('90', '270'))
    return round(mode['height' if turned else 'width'] / output['scale'])


def places(enabled, primary):
    """Each enabled output's layout x: the primary at 0, the others to its right."""
    x, result = 0, {}
    for name in sorted(enabled, key=lambda n: n != primary):
        result[name] = x
        x += logical_width(enabled[name])
    return result


def arrange(env, primary):
    """Make one output primary, moving the desktop and windows with it.

    The compositor takes the primary's name from the session's IPC directory.
    The layout has to change too, or windows stay on their screen. Xwayland
    holds new positions until an output reports a change, so place each one a
    pixel off first and then exactly, which also covers a lone output.
    """
    enabled = {n: o for n, o in outputs(env).items() if o.get('enabled')}
    if primary not in enabled:
        sys.exit(f'{primary} is not enabled.')
    ipc = session()[1]
    temporary = ipc / 'primary.tmp'
    temporary.write_text(primary + '\n')
    temporary.replace(ipc / 'primary')
    time.sleep(1)  # for the compositor to read it
    for offset in (1, 0):
        command = ['wlr-randr']
        for name, x in places(enabled, primary).items():
            command += ['--output', name, '--pos', f'{x},{offset}']
        subprocess.run(command, env=env, check=True, timeout=30)
        time.sleep(.5)
    print(f'{primary} is the primary screen.', flush=True)


def disable(env):
    subprocess.run(['wlr-randr', '--output', EXTERNAL, '--off'], env=env, check=True, timeout=30)


def turn_off(env):
    if outputs(env).get(EXTERNAL, {}).get('enabled'):
        arrange(env, UPPER)
        disable(env)


class Link:
    """A connector state that counts only after SETTLE equal readings."""

    def __init__(self):
        self.connected = self.reading = False
        self.count = 0

    def update(self, reading):
        """The new state when it changes, otherwise None."""
        self.count = self.count + 1 if reading == self.reading else 1
        self.reading = reading
        if self.count >= SETTLE and reading != self.connected:
            self.connected = reading
            return reading
        return None


def connected():
    for status in Path('/sys/class/drm').glob(f'card*-{EXTERNAL}/status'):
        try:
            if status.read_text().strip() == 'connected':
                return True
        except OSError:
            pass
    return False


def turn_on(env):
    """Enable DP-1 as the primary screen, and undo that on display errors."""
    names = outputs(env)
    if EXTERNAL not in names:
        sys.exit('No monitor is detected on DP-1.')
    if not names.get(UPPER, {}).get('enabled') or names.get(LOWER, {}).get('enabled'):
        sys.exit('Expected the upper panel on and the lower panel off; this is not a '
                 'win4wine session, or enabling DP-1 would drive three displays.')
    if names[EXTERNAL].get('enabled'):
        arrange(env, EXTERNAL)
        return
    modes = [m for m in names[EXTERNAL].get('modes', [])
             if m['width'] <= 1920 and m['height'] <= 1080]
    if not modes:
        sys.exit('The monitor reports no mode at or below 1920x1080.')
    mode = max(modes, key=lambda m: (m['width'] * m['height'], -abs(m['refresh'] - 60)))
    # The watchdog depends on the kernel log: fail before enabling if it is unreadable.
    since = int(time.time())
    if not subprocess.check_output(['journalctl', '-k', '-b', '-n', '1', '-q'], timeout=10):
        sys.exit('Cannot read the kernel log; refusing to enable DP-1 unguarded.')
    # Clear of the other outputs, wherever an earlier arrangement left them.
    right = max(o['position']['x'] + logical_width(o) for o in names.values() if o.get('enabled'))
    command = ['wlr-randr', '--output', EXTERNAL, '--on',
               '--mode', f"{mode['width']}x{mode['height']}@{mode['refresh']:.6f}Hz",
               '--transform', 'normal', '--scale', '1', '--pos', f'{right},0']
    print(f"Enabling {EXTERNAL} at {mode['width']}x{mode['height']}, "
          f"{mode['refresh']:.3f} Hz; watching the kernel log for {WATCH_SECONDS} s.", flush=True)
    healthy = False
    try:
        subprocess.run(command, env=env, check=True, timeout=30)
        arrange(env, EXTERNAL)
        for _ in range(WATCH_SECONDS):
            time.sleep(1)
            found = kernel_errors(since)
            if found:
                print('Display driver errors:', *found[:10], sep='\n  ')
                break
            if not connected():
                print('The monitor was removed again.')
                return
        else:
            now = outputs(env)
            healthy = bool(now.get(EXTERNAL, {}).get('enabled') and now[UPPER].get('enabled'))
    finally:
        # A monitor that was pulled out is left to the unplug handling.
        if not healthy and connected():
            try:
                arrange(env, UPPER)
            finally:
                disable(env)
                print(f'{EXTERNAL} switched back off.')
    if not healthy:
        sys.exit(1)
    print('Both displays stayed enabled with no driver errors. Check the picture by eye.')


def plugged(env):
    for _ in range(15):
        if EXTERNAL in outputs(env):
            turn_on(env)
            return
        time.sleep(1)
    sys.exit(f'The compositor does not list {EXTERNAL}.')


def watch(env):
    """Follow plug and unplug until the session's supervisor has gone."""
    lock = open(Path(env['XDG_RUNTIME_DIR']) / 'win4wine-external.lock', 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit('Another watcher is running.')
    link, seen = Link(), False
    print(f'Watching {EXTERNAL}.', flush=True)
    while True:
        try:
            shell = session()[0].get('shell')
        except SystemExit:
            if seen:
                return
            time.sleep(1)  # the session is still starting
            continue
        if shell not in AUTOMATIC_SHELLS:
            print(f'Automatic switching is limited to Windows 7 and XP, not {shell}.')
            return
        # An earlier watcher may have left the monitor's arrangement behind.
        stale = not seen and not connected() and primary_name() == EXTERNAL
        seen = True
        change = link.update(connected())
        if change is not None or stale:
            if change is not None:
                print(time.strftime('%F %T'), 'plugged' if change else 'unplugged', flush=True)
            # A failure is not retried until the cable changes again.
            try:
                if change:
                    plugged(env)
                else:
                    arrange(env, UPPER)
            except (SystemExit, OSError, KeyError, StopIteration, subprocess.SubprocessError) as error:
                print(error)
            sys.stdout.flush()
        time.sleep(1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('on', 'off', 'status', 'desktop', 'watch'))
    parser.add_argument('screen', nargs='?', choices=('external', 'handheld'))
    args = parser.parse_args()
    action = args.action
    if (action == 'desktop') != bool(args.screen):
        parser.error('use "desktop external" or "desktop handheld"')
    env = environment()
    if action == 'on':
        turn_on(env)
    elif action == 'off':
        turn_off(env)
    elif action == 'desktop':
        arrange(env, EXTERNAL if args.screen == 'external' else UPPER)
    elif action == 'watch':
        watch(env)
    else:
        for name, output in outputs(env).items():
            current = next((m for m in output.get('modes', []) if m.get('current')), None)
            state = 'off'
            if output.get('enabled'):
                state = f"{current['width']}x{current['height']}" if current else 'on'
                state += f" at {output['position']['x']},{output['position']['y']}"
            print(f'{name}: {state}')
        print(f'primary: {primary_name() or "unknown"}')


if __name__ == '__main__':
    main()
