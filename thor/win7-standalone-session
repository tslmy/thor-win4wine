#!/bin/bash
set -euo pipefail
base=$HOME/.local/share/win4wine
state=$HOME/.local/state/win4wine-win7
config=${XDG_CONFIG_HOME:-$HOME/.config}/win4wine/win7-standalone.json
[[ -x $base/labwc/bin/labwc && -f $config ]] || { echo 'Win7 runtime/config missing.' >&2; exit 1; }
for status in /sys/class/drm/card*-DP-*/status; do
    [[ -r $status ]] || continue
    [[ $(cat "$status") != connected ]] || { echo 'Disconnect DP before an unprotected session switch.' >&2; exit 1; }
done
: "${XDG_RUNTIME_DIR:?SDDM session required}"
[[ -n ${XDG_SEAT:-} && -n ${XDG_VTNR:-} ]] || { echo 'Use an SDDM seat session, not SSH directly.' >&2; exit 1; }
mkdir -p "$state"
exec 8>"$XDG_RUNTIME_DIR/win4wine-window.lock"
flock -w 20 8 || { echo 'Another win4wine shell is running.' >&2; exit 1; }
exec 9>"$XDG_RUNTIME_DIR/win4wine-standalone.lock"
flock -w 20 9 || exit 1
unset DISPLAY WAYLAND_DISPLAY XAUTHORITY SESSION_MANAGER
unset QT_IM_MODULE GTK_IM_MODULE QT_QPA_PLATFORMTHEME PLASMA_INTEGRATION_USE_PORTAL
unset WIN4WINE_DISPLAY WIN4WINE_GEOMETRY WIN4WINE_OUTPUT WIN4WINE_SHELL WIN4WINE_SWITCHER WIN4WINE_FOLDER_SHELL
export XDG_CURRENT_DESKTOP=Win7-Shell XDG_SESSION_DESKTOP=win7-shell XDG_SESSION_TYPE=wayland
export PYTHONPATH="$base/python${PYTHONPATH:+:$PYTHONPATH}" FEX_ROOTFS="$base/rootfs"
export LD_LIBRARY_PATH="$base/labwc/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$base/rootfs/usr/bin"
export LIBSEAT_BACKEND=logind WLR_BACKENDS=drm,libinput WLR_NO_HARDWARE_CURSORS=1
export XCURSOR_THEME=win4wine-win7 XCURSOR_SIZE=32
systemctl --user stop graphical-session.target || true
export WIN4WINE_IPC
WIN4WINE_IPC=$(mktemp -d "$XDG_RUNTIME_DIR/win4wine-win7-XXXXXX")
export WIN4WINE_STANDALONE_CONFIG=$config
exec "$base/labwc/bin/labwc" -V -C "$base/labwc-config" \
    -S "$base/tools/win7-standalone-start" >> "$state/compositor.log" 2>&1
